<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</Property>
        <Property name="LOG_PATTERN_COLOR">%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5level}{FATAL=red blink, ERROR=red, WARN=yellow bold, INFO=green, DEBUG=cyan, TRACE=blue} %style{[%t]}{magenta} %style{%logger{36}}{cyan} - %msg%n</Property>
        <Property name="APP_NAME">socius-mvc</Property>
        <Property name="LOG_PATH">logs/${APP_NAME}</Property>
    </Properties>

    <Appenders>
        <!-- Console Appender with color -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN_COLOR}"/>
        </Console>

        <!-- Application Log File -->
        <RollingFile name="AppFile"
                     fileName="${LOG_PATH}/application.log"
                     filePattern="${LOG_PATH}/application-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30" compressionLevel="9">
                <Delete basePath="${LOG_PATH}" maxDepth="1">
                    <IfFileName glob="application-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- Error Log File -->
        <RollingFile name="ErrorFile"
                     fileName="${LOG_PATH}/error.log"
                     filePattern="${LOG_PATH}/error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30" compressionLevel="9"/>
        </RollingFile>

        <!-- Security Log File -->
        <RollingFile name="SecurityFile"
                     fileName="${LOG_PATH}/security.log"
                     filePattern="${LOG_PATH}/security-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="90" compressionLevel="9"/>
        </RollingFile>

        <!-- SQL/MyBatis Log File -->
        <RollingFile name="SqlFile"
                     fileName="${LOG_PATH}/sql.log"
                     filePattern="${LOG_PATH}/sql-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="14" compressionLevel="9"/>
        </RollingFile>

        <!-- Performance Log File -->
        <RollingFile name="PerfFile"
                     fileName="${LOG_PATH}/performance.log"
                     filePattern="${LOG_PATH}/performance-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7" compressionLevel="9"/>
        </RollingFile>

        <!-- Azure Integration Log File -->
        <RollingFile name="AzureFile"
                     fileName="${LOG_PATH}/azure.log"
                     filePattern="${LOG_PATH}/azure-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30" compressionLevel="9"/>
        </RollingFile>

        <!-- Async Wrapper for better performance -->
        <Async name="AsyncConsole" includeLocation="false">
            <AppenderRef ref="Console"/>
        </Async>
        <Async name="AsyncFile" includeLocation="true">
            <AppenderRef ref="AppFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Async>
    </Appenders>

    <Loggers>
        <!-- Application Loggers -->
        <Logger name="com.uit" level="DEBUG" additivity="false">
            <AppenderRef ref="AsyncConsole"/>
            <AppenderRef ref="AsyncFile"/>
        </Logger>

        <!-- Spring Security -->
        <Logger name="org.springframework.security" level="INFO" additivity="false">
            <AppenderRef ref="SecurityFile"/>
            <AppenderRef ref="AsyncConsole"/>
        </Logger>

        <!-- MyBatis SQL Logging -->
        <Logger name="com.uit.sociuscomodules.employee.infrastructure.persistence.mybatis" level="DEBUG" additivity="false">
            <AppenderRef ref="SqlFile"/>
            <AppenderRef ref="AsyncConsole"/>
        </Logger>
        <Logger name="org.mybatis" level="INFO" additivity="false">
            <AppenderRef ref="SqlFile"/>
        </Logger>

        <!-- Azure Integration -->
        <Logger name="com.azure" level="INFO" additivity="false">
            <AppenderRef ref="AzureFile"/>
            <AppenderRef ref="AsyncConsole"/>
        </Logger>
        <Logger name="com.microsoft.graph" level="INFO" additivity="false">
            <AppenderRef ref="AzureFile"/>
            <AppenderRef ref="AsyncConsole"/>
        </Logger>

        <!-- Spring Framework -->
        <Logger name="org.springframework" level="INFO"/>
        <Logger name="org.springframework.boot" level="INFO"/>
        <Logger name="org.springframework.web" level="DEBUG"/>
        <Logger name="org.springframework.boot.actuate" level="INFO"/>

        <!-- Spring Modulith -->
        <Logger name="org.springframework.modulith" level="DEBUG"/>

        <!-- RabbitMQ -->
        <Logger name="org.springframework.amqp" level="INFO" additivity="false">
            <AppenderRef ref="AppFile"/>
            <AppenderRef ref="AsyncConsole"/>
        </Logger>

        <!-- Hibernate Validator -->
        <Logger name="org.hibernate.validator" level="INFO"/>

        <!-- Performance Monitoring -->
        <Logger name="performance" level="DEBUG" additivity="false">
            <AppenderRef ref="PerfFile"/>
        </Logger>

        <!-- Third Party Libraries -->
        <Logger name="org.apache" level="WARN"/>
        <Logger name="org.postgresql" level="WARN"/>
        <Logger name="com.zaxxer.hikari" level="INFO"/>

        <!-- Root Logger -->
        <Root level="INFO">
            <AppenderRef ref="AsyncConsole"/>
            <AppenderRef ref="AsyncFile"/>
        </Root>
    </Loggers>
</Configuration>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.uit.sociusmvcapp.iam.internal.persistence.RolePermissionMapper">


    <resultMap id="rolePermissionResultMap" type="com.uit.sociusmvcapp.iam.internal.domain.RolePermission">
        <id property="id" column="id"/>
        <result property="roleCode" column="role_code"/>
        <result property="permissionCode" column="permission_code"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="deleteFlag" column="delete_flag"/>
    </resultMap>

    <select id="findPermissionsByRoleCodes" resultMap="rolePermissionResultMap">
        SELECT
            id,
            role_code,
            permission_code,
            created_at,
            updated_at,
            deleted_at,
            delete_flag
        FROM role_permissions
        WHERE role_code IN
        <foreach item="role" collection="roleCodes" open="(" separator="," close=")">
            #{role}
        </foreach>
        AND delete_flag = ${@com.uit.sociusmvcapp.shared.enums.DeleteFlagEnums@NOT_DELETED.value}
    </select>

</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.uit.sociusmvcapp.iam.internal.persistence.ApiPermissionMapper">

    <resultMap id="apiPermissionResultMap" type="com.uit.sociusmvcapp.iam.internal.domain.ApiPermission">
        <id property="id" column="id"/>
        <result property="permissionCode" column="permission_code"/>
        <result property="resource" column="resource"/>
        <result property="action" column="action"/>
        <result property="httpMethod" column="http_method"/>
        <result property="urlPattern" column="url_pattern"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="deleteFlag" column="delete_flag"/>
    </resultMap>

    <select id="findAll" resultMap="apiPermissionResultMap">
        SELECT id,
               permission_code,
               resource,
               action,
               http_method,
               url_pattern,
               created_at,
               updated_at,
               deleted_at,
               delete_flag
        FROM api_permissions
        WHERE delete_flag = ${@com.uit.sociusmvcapp.shared.enums.DeleteFlagEnums@NOT_DELETED.value}
        ORDER BY url_pattern, http_method
    </select>

    <select id="findByMethodAndPattern" resultMap="apiPermissionResultMap">
        SELECT id,
               permission_code,
               resource,
               action,
               http_method,
               url_pattern,
               created_at,
               updated_at,
               deleted_at,
               delete_flag
        FROM api_permissions
        WHERE http_method = #{httpMethod}
          AND url_pattern = #{urlPattern}
          AND delete_flag = ${@com.uit.sociusmvcapp.shared.enums.DeleteFlagEnums@NOT_DELETED.value}
    </select>

</mapper>

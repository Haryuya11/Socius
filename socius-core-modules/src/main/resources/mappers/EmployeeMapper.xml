<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.uit.sociuscoremodules.employee.persistence.EmployeeMapper">

    <resultMap id="findAllEmployeeMap" type="com.uit.sociuscoremodules.employee.domain.Employee">
        <id property="id" column="id"/>
        <result property="clientId" column="client_id"/>
        <result property="userId" column="user_id"/>
        <result property="firstName" column="first_name"/>
        <result property="lastName" column="last_name"/>
        <result property="teamCode" column="team_code"/>
        <result property="departmentCode" column="department_code"/>
        <result property="roleCode" column="role_code"/>
        <result property="imageUrl" column="image_url"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="deleteFlag" column="delete_flag"/>
    </resultMap>


    <select id="getEmployeeById" resultMap="findAllEmployeeMap">
        SELECT id,
               client_id,
               user_id,
               first_name,
               last_name,
               team_code,
               department_code,
               role_code,
               image_url,
               created_at,
               updated_at,
               deleted_at,
               delete_flag
        FROM employee
        WHERE client_id = #{id}
        and delete_flag = 0
    </select>

</mapper>
